{
 "uid": "obs-logs",
 "title": "Log explorer",
 "tags": [
  "observability",
  "logs"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Log rate theo service",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (service) (count_over_time({service=~\"$service\"}[$__interval]))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{service}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Dòng lỗi theo service (error|exception|fatal)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (service) (count_over_time({service=~\"$service\"} |~ \"(?i)(error|exception|fatal|traceback)\" [$__interval]))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{service}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Rails: HTTP status (từ lograge JSON)",
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum by (status) (count_over_time({service=\"rails\", status!=\"\"}[$__interval]))",
     "queryType": "range",
     "editorMode": "code",
     "legendFormat": "{{status}}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Rails: 5xx trong khoảng thời gian",
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "sum(count_over_time({service=\"rails\", status=~\"5..\"}[$__range]))",
     "queryType": "instant",
     "editorMode": "code",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Rails: p95 duration (ms)",
   "gridPos": {
    "x": 18,
    "y": 7,
    "w": 6,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "quantile_over_time(0.95, {service=\"rails\", status!=\"\"} | json | unwrap duration [$__range])",
     "queryType": "instant",
     "editorMode": "code",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 6,
   "type": "logs",
   "title": "Log (lọc theo service + tìm kiếm)",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 12
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{service=~\"$service\"} |~ \"(?i)$search\"",
     "queryType": "range",
     "editorMode": "code",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "enableLogDetails": true,
    "sortOrder": "Descending",
    "dedupStrategy": "none"
   }
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Chỉ dòng lỗi / 5xx",
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{service=~\"$service\"} |~ \"(?i)(error|exception|fatal|traceback)|\\\"status\\\":5[0-9][0-9]\"",
     "queryType": "range",
     "editorMode": "code",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ],
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "query": "label_values(service)",
     "refId": "s",
     "type": 1
    },
    "definition": "label_values(service)",
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   },
   {
    "name": "search",
    "label": "Tìm kiếm",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "annotations": {
  "list": []
 }
}