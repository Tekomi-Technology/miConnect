# Sao chép thành .env (chmod 600). KHÔNG commit .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=doi-mat-khau-manh
# IP VPN WireGuard của VPS (wg0 phải lên trước docker). 127.0.0.1 = chỉ truy cập qua SSH tunnel
GRAFANA_BIND_ADDR=10.78.0.1
GRAFANA_PORT=3300
GRAFANA_ROOT_URL=http://10.78.0.1:3300/

# Redis của Chatwoot (cùng network docker chatwoot_default)
CHATWOOT_NETWORK=chatwoot_default
REDIS_ADDR=redis://redis:6379
REDIS_PASSWORD=

# Telegram (đang HOLD, để trống cũng được)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
